# ==============================================================================
# LLM API Configuration
# ==============================================================================

# 1. Option A: Custom / OpenAI-compatible / Proxy Endpoint
# Provide your API key and the full completions URL:
BOB_API_KEY=
BOB_API_URL=
LLM_MODEL=ibm/granite-3-8b-instruct

# 2. Option B: IBM watsonx.ai (IBM Cloud IAM API key)
# If using IBM watsonx.ai directly, set your IBM Cloud API key and project ID:
# WATSONX_API_KEY=your_ibm_cloud_iam_api_key
# WATSONX_PROJECT_ID=your_watsonx_project_guid
# WATSONX_URL=https://us-south.ml.cloud.ibm.com
# WATSONX_MODEL_ID=ibm/granite-3-8b-instruct
